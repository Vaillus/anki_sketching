# Path where SQLite DBs and card_positions.json live.
# Unset locally (defaults to ./data). Set to the mounted volume path on Railway (e.g. /data).
DATA_DIR=

# Single shared password for HTTP Basic Auth. If unset, the app is unauthenticated (local dev).
# Username is ignored; any non-empty value is accepted as long as the password matches.
APP_PASSWORD=

# Explicit environment name. Set to "production" on Railway. Primary signal for
# is_production() (src/utilities/env.py); falls back to Railway's auto vars if unset.
APP_ENV=

# --- Local-only: prod -> Mac sync (do NOT set these on Railway) ---
# Base URL the local app pulls from. Defaults to the known Railway URL if unset.
PROD_URL=
# Password to authenticate to prod (same value as prod's APP_PASSWORD).
# Never name this APP_PASSWORD locally or you'd switch on the local auth middleware.
PROD_PASSWORD=
